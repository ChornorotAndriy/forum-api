// use prisma-8

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
  posts        Post[]
}

model Post {
  id       Int    @id @default(autoincrement())
  title    String
  content  String
  category String
  authorId Int
  author   User   @relation(fields: [authorId], references: [id])
}
